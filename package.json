{
  "name": "parlamento",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace frontend",
    "data:import:congress": "node --disable-warning=ExperimentalWarning data/scripts/import-congress-deputies.mjs",
    "data:import:initiatives": "node --disable-warning=ExperimentalWarning data/scripts/import-legislative-initiatives.mjs",
    "data:import:photos": "node --disable-warning=ExperimentalWarning data/scripts/import-deputy-photos.mjs",
    "dev": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
